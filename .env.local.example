# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Numero de WhatsApp do dono para receber orcamentos, formato internacional sem simbolos
# Exemplo: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
